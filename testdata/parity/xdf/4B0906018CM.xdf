<XDFTABLE uniqueid="0x26efc">
  <title>TSKRLDAB</title>
  <description>Zeitkonstante für schnelle LDR-Absenkung</description>
    <XDFAXIS id="x">
      <EMBEDDEDDATA mmedaddress="0x13450" mmedelementsizebits="16" />
      <units>U/min</units>
      <indexcount>8</indexcount>
      <MATH equation="0.25 * X"><VAR id="X" /></MATH>
    </XDFAXIS>
    <XDFAXIS id="y">
